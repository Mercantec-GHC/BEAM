@inject IJSRuntime JS

<beam-cover-flow @key="Games" class="cover-flow" aria-label="Game selector" aria-roledescription="carousel">
    @if (Games.Count == 0)
    {
        <p class="empty">Your next adventure is on its way. Add some games to get started.</p>
    }
    else
    {
        @* Five visible covers plus two occluded buffers keep wrapping smooth with a bounded image pool. *@
        <div class="game-data" hidden>
            @foreach (var game in Games)
            {
                <span data-title="@game.Title" data-genre="@game.Genre" data-image="@game.ImageUrl" data-launch="@game.LaunchUrl"></span>
            }
        </div>
        <div class="flow-stage" tabindex="0" aria-label="Game covers. Use left and right arrow keys to browse.">
            <div class="cover-window">
            @for (var slot = Games.Count == 1 ? 0 : -3; slot <= (Games.Count == 1 ? 0 : 3); slot++)
            {
                var index = (slot % Games.Count + Games.Count) % Games.Count;
                var game = Games[index];
                var hidden = Math.Abs(slot) > 2;
                <button type="button" class="game-cover" data-slot="@slot" data-index="@index"
                        style="@CoverStyle(slot)" tabindex="@(hidden ? -1 : 0)"
                        aria-hidden="@(hidden ? "true" : "false")" aria-label="Select @game.Title" aria-pressed="@(slot == 0 ? "true" : "false")">
                    <img src="@game.ImageUrl" alt="@game.Title cover" draggable="false" decoding="async" width="600" height="600" />
                </button>
            }
            </div>
        </div>
        <span class="selection-status" role="status" aria-live="polite" aria-atomic="true">@Games[0].Title</span>
    }
</beam-cover-flow>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<GameCover> Games { get; set; } = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Register once; input and animation never need a server round trip.
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Games/GameCoverFlow.razor.js");
        }
    }

    private static string CoverStyle(int slot) => $"z-index:{10 - Math.Abs(slot)}";
}






